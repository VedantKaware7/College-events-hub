            "url": {
              "raw": "{{base_url}}/registrations?status=pending",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "registrations"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Approve registration – paid (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
