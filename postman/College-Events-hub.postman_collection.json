              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{event_id}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/registrations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "description": "Set `otp` to the registration code first."
          }
        },
        {
          "name": "My registrations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
