# MongoDB (local: mongodb://localhost:27017/college_events_hub, prod: MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/college_events_hub

# Any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Email for OTP / approval messages. Configure ONE option, or leave all empty in
# development (OTP codes are then printed in the server logs).
# Option 1 – Brevo HTTPS API (required on Render free tier, which blocks SMTP)
BREVO_API_KEY=
MAIL_FROM=
# Option 2 – Gmail SMTP with an App Password (local / Docker)
EMAIL_USER=
EMAIL_PASS=

PORT=5000

# Comma-separated list of allowed browser origins (leave empty to allow all)
CLIENT_URL=http://localhost:5173
